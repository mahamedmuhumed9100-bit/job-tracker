@model JobTracker.Models.JobApplication
@using JobTracker.Models
@{
    ViewData["Title"] = "Delete Application";
}

<h1>Delete Application</h1>

<div class="alert alert-warning col-md-6">
    Are you sure you want to delete this application? This also deletes its full status history and can't be undone.
</div>

<dl class="row col-md-6">
    <dt class="col-sm-4">Company</dt>
    <dd class="col-sm-8">@Model.CompanyName</dd>
    <dt class="col-sm-4">Role</dt>
    <dd class="col-sm-8">@Model.RoleTitle</dd>
    <dt class="col-sm-4">Status</dt>
    <dd class="col-sm-8"><span class="badge @Model.CurrentStatus.BadgeClass()">@Model.CurrentStatus.DisplayName()</span></dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
